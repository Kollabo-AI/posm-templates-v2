#!/usr/bin/env python3
"""Resolve Secrets Manager dynamic references through the local AWS provider."""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request


PATTERN = re.compile(r"\{\{resolve:secretsmanager:([^}]+)\}\}")
SMA_ENDPOINT = os.environ.get(
    "AWS_SECRETS_MANAGER_AGENT_ENDPOINT", "http://localhost:2773"
)
SMA_STARTUP_TIMEOUT_SECONDS = float(
    os.environ.get("ASM_EXEC_SMA_STARTUP_TIMEOUT_SECONDS", "20")
)
SMA_RETRY_INTERVAL_SECONDS = float(
    os.environ.get("ASM_EXEC_SMA_RETRY_INTERVAL_SECONDS", "0.1")
)
SSRF_TOKEN = os.environ.get("AWS_SESSION_TOKEN", os.environ.get("AWS_TOKEN", ""))


def _wait_for_provider() -> None:
    deadline = time.monotonic() + max(SMA_STARTUP_TIMEOUT_SECONDS, 0)
    while True:
        try:
            with urllib.request.urlopen(f"{SMA_ENDPOINT}/ping", timeout=1) as response:
                if response.read() == b"healthy":
                    return
        except (urllib.error.URLError, OSError):
            pass
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise RuntimeError("local Secrets Manager provider did not become healthy")
        time.sleep(min(max(SMA_RETRY_INTERVAL_SECONDS, 0.01), remaining))


def _parse_reference(reference: str) -> tuple[str, str | None, str]:
    if not reference.startswith("arn:"):
        raise ValueError("Secrets Manager reference must use a full ARN")
    parts = reference.split(":")
    if len(parts) < 7 or parts[2] != "secretsmanager" or parts[5] != "secret":
        raise ValueError("Secrets Manager reference must use a valid secret ARN")
    secret_arn = ":".join(parts[:7])
    remainder = parts[7:]
    field_type = remainder[0] if remainder else "SecretString"
    json_key = remainder[1] if len(remainder) > 1 and remainder[1] else None
    version_stage = remainder[2] if len(remainder) > 2 else "AWSCURRENT"
    if field_type != "SecretString":
        raise ValueError("only SecretString references are supported")
    return secret_arn, json_key, version_stage


def _resolve_reference(reference: str) -> str:
    secret_arn, json_key, version_stage = _parse_reference(reference)
    query = urllib.parse.urlencode(
        {"secretId": secret_arn, "versionStage": version_stage}
    )
    request = urllib.request.Request(
        f"{SMA_ENDPOINT}/secretsmanager/get?{query}", method="GET"
    )
    if SSRF_TOKEN:
        request.add_header("X-Aws-Parameters-Secrets-Token", SSRF_TOKEN)
    try:
        with urllib.request.urlopen(request, timeout=5) as response:
            payload = json.loads(response.read())
    except (urllib.error.URLError, OSError, json.JSONDecodeError) as error:
        raise RuntimeError("local Secrets Manager resolution failed") from error
    value = payload.get("SecretString")
    if not isinstance(value, str):
        raise RuntimeError("local provider returned no SecretString")
    if json_key:
        try:
            parsed = json.loads(value)
            value = parsed[json_key]
        except (json.JSONDecodeError, KeyError, TypeError) as error:
            raise RuntimeError("requested SecretString JSON key was unavailable") from error
        if not isinstance(value, str):
            value = json.dumps(value, separators=(",", ":"))
    return value


def _resolve_string(value: str) -> str:
    return PATTERN.sub(lambda match: _resolve_reference(match.group(1)), value)


def main() -> None:
    command = sys.argv[1:]
    if command and command[0] == "--":
        command = command[1:]
    if not command:
        raise RuntimeError("usage: asm-exec -- command [args...]")
    has_references = any(PATTERN.search(value) for value in command) or any(
        PATTERN.search(value) for value in os.environ.values()
    )
    if has_references:
        _wait_for_provider()
    resolved_command = [
        _resolve_string(value) if PATTERN.search(value) else value for value in command
    ]
    resolved_environment = {
        key: _resolve_string(value) if PATTERN.search(value) else value
        for key, value in os.environ.items()
    }
    result = subprocess.run(resolved_command, env=resolved_environment, check=False)
    raise SystemExit(result.returncode)


if __name__ == "__main__":
    main()
